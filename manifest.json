{
  "manifest_version": 3,
  "name": "Phish-i",
  "version": "0.1.0",
  "description": "Warns you about phishing emails, lookalike websites, and third-party trackers.",
  "permissions": ["identity", "storage"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://gmail.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content/gmail-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Phish-i"
  },
  "oauth2": {
    "client_id": "853523200345-teil1h9nfiuoavkaesg10g5sf729t6u0.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
  },
  "key":""

}
