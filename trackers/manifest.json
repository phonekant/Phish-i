{
  "manifest_version": 3,
  "name": "Phish-i Tracker Blocker",
  "version": "0.1.0",
  "description": "Detects and blocks third-party web trackers.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "tracker_ruleset",
        "enabled": true,
        "path": "rules/tracker_rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Phish-i Tracker Shield"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "phish-i-dev@wesleyan.edu",
      "strict_min_version": "121.0"
    }
  }
}